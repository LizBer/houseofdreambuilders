---
// The house mark: an H on the accent tile, with the margin rule beside it.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg class={cls} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="8" fill="hsl(27 82% 60%)" />
  <path d="M8 9v14M17 9v14M8 16h9" fill="none" stroke="hsl(20 45% 7%)" stroke-width="2.6" stroke-linecap="round" />
  <path class="mark__rule" d="M23.5 6v20" stroke="hsl(34 45% 96%)" stroke-width="1.6" stroke-linecap="round" />
</svg>
