---
import { site, nav } from '../data/site';
import Mark from './Mark.astro';
import Btn from './Btn.astro';
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---
<header class="site-header">
  <a class="brand" href="/" aria-label={`${site.name}, home`}>
    <Mark class="brand__mark" />
    <span class="brand__name"><span class="brand__full">House of </span>Dreambuilders</span>
  </a>
  <nav class="site-nav" aria-label="Main">
    <ul>
      {nav.map((n) => (
        <li><a class="draw" href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
      ))}
    </ul>
    <Btn href="/systems/edit-starter-kit/" small arrow={false}>Get the kit</Btn>
  </nav>
</header>
