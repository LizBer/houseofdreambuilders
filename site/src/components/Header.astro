---
import { site, nav, kit } from '../data/site';
import Mark from './Mark.astro';
import Btn from './Btn.astro';
// `landing`: a focused landing page keeps only the brand and its own call to action.
interface Props { landing?: boolean; cta?: { href: string; label: string } }
const { landing = false, cta = { href: kit.optinUrl, label: 'Get the free kit' } } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes('#') && path.startsWith(href);
---
<header class="site-header">
  <a class="brand" href="/" aria-label={`${site.name}, home`}>
    <Mark class="brand__mark" />
    <span class="brand__name"><span class="brand__full">House of </span>Dreambuilders</span>
  </a>
  <nav class="site-nav" aria-label="Main">
    {!landing && (
      <ul>
        {nav.map((n) => (
          <li><a class="draw" href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    )}
    {landing
      ? <Btn href={cta.href} small arrow={false}>{cta.label}</Btn>
      : <Btn href="/#apply" small arrow={false}>Apply</Btn>}
  </nav>
</header>
