---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import Countdown from '../components/Countdown.astro';
import { site, reels, program } from '../data/site';
// The cut: stumbles are shown with CSS generated content (not in the heading's text), then edited out.
const headline = 'Talk to your camera tonight. Post a finished reel tomorrow.';
const stumbles: Record<number, string> = { 3: 'um,', 6: 'uh, wait,' };
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: reels.name,
  description: reels.promise,
  brand: { '@type': 'Brand', name: site.name },
  url: new URL(reels.href, site.url).href,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR', priceValidUntil: reels.endsAt.slice(0, 10) },
};
---
<Base
  title={reels.name}
  description={`The AI video editing starter kit for moms who record but never post. Normally ${reels.normalPrice}, free for seven days.`}
  jsonLd={productLd}
  landing
  cta={{ href: reels.optinUrl, label: 'Join free' }}
>
  <!-- HERO: headline is edited live (the cut), then the video opens from a phone clip -->
  <section class="hero hero--vsl" data-margin="8" aria-labelledby="room-h1">
    <div class="grid">
      <div data-day>
        <p class="hand vsl__aside" data-reveal="write" data-intro data-delay="2.4">watch this first. it’s six minutes.</p>
      </div>
      <div data-dream>
        <p class="vsl__kicker" data-reveal="fade" data-intro>{reels.name} · normally {reels.normalPrice}, free for 7 days</p>
        <h1 id="room-h1" class="vsl__title" data-cut>{headline.split(' ').map((w, i) => (
          <><span class="cw">{w}</span>{' '}{stumbles[i] && <><span class="cut" data-text={stumbles[i]} aria-hidden="true"><span class="cut__line"></span></span>{' '}</>}</>
        ))}</h1>
        <!-- PLACEHOLDER: replace the inside of .vsl with the real video embed. -->
        <div class="vsl" data-vsl>
          <div class="vsl__frame">
            <span class="vsl__play" aria-hidden="true"><span class="vsl__ring"></span><svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15l13-7.5z" /></svg></span>
            <span class="vsl__note">your video goes here</span>
            <span class="vsl__tag" aria-hidden="true"><span class="time" data-vsl-tag>raw take · 02:41</span></span>
            <span class="vsl__bar" aria-hidden="true"></span>
          </div>
        </div>
        <p class="vsl__meta" data-reveal="fade" data-intro data-delay="2.6"><span class="time">06:12</span> How one raw recording becomes a finished reel, start to finish.</p>
      </div>
    </div>
  </section>

  <!-- THE OFFER: the timer -->
  <section class="sec sec--tight" data-margin="8" id="offer" aria-labelledby="offer-title">
    <div class="grid">
      <div data-day>
        <ol class="schedule" aria-label="A reel without the room">
          <li data-reveal="write"><span class="time">12:40</span><span>Record a reel at lunch</span></li>
          <li data-reveal="write" data-delay="0.08"><span class="time">21:12</span><span>Open the editor. Close it.</span></li>
          <li class="is-margin" data-reveal="write" data-delay="0.16"><span class="time">Day 34</span><span>Still in the camera roll</span></li>
        </ol>
        <p class="hand" style="margin-top:1.25rem" data-reveal="write" data-delay="0.3">sound familiar? come on in.</p>
      </div>
      <div data-dream>
        <h2 id="offer-title" class="l" data-split="lines">The room is free this week</h2>
        <div class="offer offer--big">
          <p class="price" data-reveal="up">
            <span class="sr-only">Normally {reels.normalPrice}, now free.</span>
            <span class="price__was" aria-hidden="true">{reels.normalPrice}</span>
            <span class="price__now" aria-hidden="true">Free</span>
            <span class="hand" aria-hidden="true">for 7 days only</span>
          </p>
          <div data-reveal="up" data-delay="0.08"><Countdown endsAt={reels.endsAt} endsLabel={reels.endsLabel} normalPrice={reels.normalPrice} /></div>
          <div class="actions" data-reveal="up" data-delay="0.16"><Btn href={reels.optinUrl}>Join the room free</Btn></div>
        </div>
        <p class="body" style="margin-top:1.75rem">{reels.promise}</p>
      </div>
    </div>
  </section>

  <!-- WHAT'S INSIDE -->
  <section class="sec" data-margin="8" aria-labelledby="inside-title">
    <div class="grid">
      <div data-day>
        <p class="label">Inside the room</p>
        <p class="hand" style="margin-top:1.25rem" data-reveal="write">the editing, handled</p>
      </div>
      <div data-dream>
        <h2 id="inside-title" class="l" data-split="lines">Everything between “recorded” and “posted”, done for you</h2>
        <ul class="ticks" style="margin-top:2.5rem">
          {reels.inside.map((x, i) => <li data-reveal="up" data-delay={String((i % 2) * 0.06)}><h3>{x.title}</h3><p>{x.text}</p></li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- HOW IT GOES -->
  <section class="sec sec--tight" data-margin="8" aria-labelledby="how-title">
    <div class="grid">
      <div data-day>
        <h2 id="how-title" class="label">A week in the room</h2>
      </div>
      <div data-dream>
        <ol class="steps">
          {reels.steps.map((s, i) => (
            <li data-reveal="write" data-delay={String(i * 0.08)}>
              <h3>{s.title}</h3>
              <span class="time">{s.cost}</span>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- LIZZY -->
  <section class="sec" data-margin="10" aria-labelledby="why-title">
    <div class="grid">
      <div data-day>
        <p class="label">Why it’s free this week</p>
      </div>
      <div data-dream>
        <div class="letter">
          <h2 id="why-title" class="m" data-split="lines">My camera roll used to be full of reels I never had the energy to finish.</h2>
          <p class="body" data-reveal="up">So I built an editor that already knows my captions, my colours and my pace. It gave me my evenings back, and I want you to feel that too. For seven days, the room is yours for free.</p>
          <p class="hand sign" data-reveal="write">see you inside, Lizzy</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="sec" data-margin="10" id="faq" aria-labelledby="faq-title">
    <div class="grid">
      <div data-day>
        <p class="label">Questions</p>
      </div>
      <div data-dream>
        <h2 id="faq-title" class="l" data-split="lines">Before you join</h2>
        <div class="faq">
          {reels.faq.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </div>
      </div>
    </div>
  </section>

  <!-- FINALE -->
  <section class="sec sec--airy finale" data-margin="full" id="join" aria-labelledby="join-title">
    <div class="grid">
      <div data-dream>
        <h2 id="join-title" class="mega" data-split="lines">Your next reel, finished tonight</h2>
        <div class="offer" data-reveal="up">
          <p class="price">
            <span class="sr-only">Normally {reels.normalPrice}, now free.</span>
            <span class="price__was" aria-hidden="true">{reels.normalPrice}</span>
            <span class="price__now" aria-hidden="true">Free</span>
          </p>
          <Countdown endsAt={reels.endsAt} endsLabel={reels.endsLabel} normalPrice={reels.normalPrice} size="small" />
          <div class="actions">
            <!-- PLACEHOLDER: point reels.optinUrl at the real sign-up form. -->
            <Btn href={reels.optinUrl}>Join the room free</Btn>
          </div>
        </div>
        <p class="body" style="margin-top:2.5rem">Ready to build the whole business, not just the reels? <a class="link" href="/#method">See {program.name}</a></p>
      </div>
    </div>
  </section>
</Base>
