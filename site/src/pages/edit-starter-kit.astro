---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import { site, kit, program } from '../data/site';
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: kit.name,
  description: kit.promise,
  brand: { '@type': 'Brand', name: site.name },
  url: new URL(kit.href, site.url).href,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<Base title={`${kit.name} (free)`} description="Free Edit Starter Kit: record yourself talking and get finished reels back in your own style, ready to post. The editing runs on your own computer." jsonLd={productLd} landing>
  <section class="hero" data-margin="6" aria-labelledby="kit-h1">
    <div class="grid">
      <div data-day>
        <p class="label" data-reveal="fade" data-intro>For moms building a business around their family</p>
        <div class="before" style="margin-top:2rem" data-reveal="write" data-intro data-delay="0.4">
          <p class="label">Without it</p>
          <p style="margin-top:.4rem">Cutting breaths, fixing stumbles and typing captions by hand, after bedtime, for every single reel.</p>
        </div>
        <p class="hand" style="margin-top:1.5rem" data-reveal="write" data-intro data-delay="0.7">started editing and ran out of energy halfway? this is for you.</p>
      </div>
      <div data-dream>
        <h1 id="kit-h1" class="xl" data-split="lines" data-intro>Finished reels, without giving up your evenings to editing</h1>
        <p class="lead" data-split="lines" data-intro data-delay="0.2">{kit.promise} The pauses, retakes and mistakes are gone when you get it back.</p>
        <div class="optin" data-reveal="fade" data-intro data-delay="0.5">
          <span class="optin__price">{kit.price} · set up in about ten minutes</span>
          <div class="actions"><Btn href={kit.optinUrl}>Get the free kit</Btn></div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--tight" data-margin="8" aria-labelledby="video-title">
    <div class="grid">
      <div data-day>
        <h2 id="video-title" class="label">Watch it work</h2>
        <p class="body" style="margin-top:.75rem">About six minutes, from a raw recording to a finished reel.</p>
      </div>
      <div data-dream>
        <!-- PLACEHOLDER: replace with the real video embed. -->
        <div class="video" data-reveal="write">
          <p class="video__slot"><span class="time">06:10 → 21:12</span><span>One raw take in, one finished reel out. The walkthrough video goes here.</span></p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" data-margin="8" aria-labelledby="out-title">
    <div class="grid">
      <div data-day>
        <p class="label">What changes</p>
      </div>
      <div data-dream>
        <h2 id="out-title" class="l" data-split="lines">Keep posting without adding to your day</h2>
        <ul class="outcomes">
          {kit.outcomes.map((o, i) => <li data-reveal="up" data-delay={String(i * 0.06)}><h3>{o.title}</h3><p>{o.text}</p></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="sec" data-margin="8" aria-labelledby="inc-title">
    <div class="grid">
      <div data-day>
        <p class="label">What’s included</p>
      </div>
      <div data-dream>
        <h2 id="inc-title" class="l" data-split="lines">Everything you need to post every week, done for you</h2>
        <ul class="ticks" style="margin-top:2.5rem">
          {kit.included.map((x, i) => <li data-reveal="up" data-delay={String((i % 2) * 0.06)}><h3>{x.title}</h3><p>{x.text}</p></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="sec sec--tight" data-margin="8" aria-labelledby="how-title">
    <div class="grid">
      <div data-day>
        <h2 id="how-title" class="label">How it goes</h2>
      </div>
      <div data-dream>
        <ol class="steps">
          {kit.steps.map((s, i) => (
            <li data-reveal="write" data-delay={String(i * 0.08)}>
              <h3>{s.title}</h3>
              <span class="time">{s.cost}</span>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
        <div class="facts">
          <div data-reveal="up"><h3>What you need</h3><p>{kit.needs}</p></div>
          <div data-reveal="up" data-delay="0.06"><h3>What you own</h3><p>{kit.owns}</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" data-margin="10" aria-labelledby="story-title">
    <div class="grid">
      <div data-day>
        <p class="label">Why I made it</p>
      </div>
      <div data-dream>
        <div class="letter">
          <h2 id="story-title" class="m" data-split="lines">I recorded plenty of videos and posted very few.</h2>
          <p class="body" data-reveal="up">Editing took the hour I didn’t have. So I built the editor I wished existed, one that already knows how I like my captions, my colours and my pace. Now it’s yours, free.</p>
          <p class="hand sign" data-reveal="write">rooting for you, Lizzy</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" data-margin="10" id="faq" aria-labelledby="faq-title">
    <div class="grid">
      <div data-day>
        <p class="label">Questions</p>
      </div>
      <div data-dream>
        <h2 id="faq-title" class="l" data-split="lines">What moms ask before they start</h2>
        <div class="faq">
          {kit.faq.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--airy finale" data-margin="full" id="get" aria-labelledby="get-title">
    <div class="grid">
      <div data-dream>
        <h2 id="get-title" class="mega" data-split="lines">Record something today</h2>
        <p class="lead" data-reveal="up">See it back finished, in your style, before the week is over.</p>
        <div class="actions" data-reveal="up" data-delay="0.1">
          <!-- PLACEHOLDER: point kit.optinUrl at the real opt-in form. -->
          <Btn href={kit.optinUrl}>Get the free kit</Btn>
        </div>
        <p class="body" style="margin-top:2.5rem">Want help building the whole business, not just the reels? <a class="link" href="/#method">See {program.name}</a></p>
      </div>
    </div>
  </section>
</Base>
