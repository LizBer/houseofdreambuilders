---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import { site, day, products, kit } from '../data/site';
---
<Base description={site.description}>
  <!-- HERO: the day on the left, the dream in the margin -->
  <section class="hero" data-margin="4" aria-labelledby="hero-title">
    <div class="grid">
      <div data-day>
        <p class="label" data-reveal="fade" data-intro data-delay="0.5">A weekday, roughly</p>
        <ol class="schedule" aria-label="A typical weekday" style="margin-top:1rem">
          {day.map((d, i) => (
            <li class:list={{ 'is-margin': d.margin }} data-reveal="write" data-intro data-delay={String(0.35 + i * 0.09)}>
              <span class="time">{d.time}</span><span>{d.text}</span>
            </li>
          ))}
        </ol>
        <p class="schedule__note" data-reveal="write" data-intro data-delay="1.05">
          <svg viewBox="0 0 40 34" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M34 30C24 30 12 26 7 6M7 6 3 13M7 6l7 4" /></svg>
          <span class="hand">this hour is yours. be supermommy, not superbusy<span class="caret" data-caret aria-hidden="true"></span></span>
        </p>
      </div>
      <div data-dream>
        <h1 id="hero-title" data-split="lines" data-intro>Build your dream in the margins of a full life</h1>
        <p class="lead" data-split="lines" data-intro data-delay="0.25">Plug-and-play AI systems and digital products for moms with a full plate and a bigger plan. You do the part only you can do. The system does the long part.</p>
        <div class="actions" data-reveal="fade" data-intro data-delay="0.6">
          <Btn href="/systems/">See the systems</Btn>
          <Btn href="/about/" quiet arrow={false}>Lizzy’s story</Btn>
        </div>
      </div>
    </div>
  </section>

  <!-- THE DAY: why the dream waits -->
  <section class="sec" data-margin="4" aria-labelledby="day-title">
    <div class="grid">
      <div data-day>
        <h2 id="day-title" class="sr-only">Why the dream keeps waiting</h2>
        <p class="statement" data-split="lines">Family, a full-time job, and maybe ten minutes for yourself. <strong>By the time the house is quiet, there’s nothing left</strong> for the thing you actually want to build.</p>
      </div>
      <div data-dream>
        <p class="hand" data-reveal="write">you’re not lazy. your day is just full.</p>
        <p class="body" style="margin-top:1.25rem" data-reveal="up" data-delay="0.1">So the dream waits for a calmer season that never quite comes. It doesn’t have to. The margin is small, but it’s real, and it can do more than you think.</p>
      </div>
    </div>
  </section>

  <!-- WHAT WE MAKE: index list -->
  <section class="sec" data-margin="6" aria-labelledby="make-title">
    <div class="grid">
      <div data-day>
        <h2 id="make-title" class="l" data-split="lines">Two kinds of help, both made for small pockets of time</h2>
        <p class="body" style="margin-top:1.25rem" data-reveal="up"><strong style="color:var(--ink)">AI systems</strong> you set up once and then run every week, on your own computer. <strong style="color:var(--ink)">Digital products</strong> that help you plan, build and grow without starting from a blank page.</p>
      </div>
      <div data-dream>
        <ul class="rows" data-reveal="up">
          {products.map((p) => (
            <li>
              {p.href ? (
                <a class="row" href={p.href}>
                  <span class="row__name">{p.name}<span class="row__open" aria-hidden="true">open</span></span>
                  <span class="row__meta"><strong>{p.status}</strong> · {p.kind}</span>
                  <span class="row__line">{p.line}</span>
                </a>
              ) : (
                <div class="row row--soon">
                  <span class="row__name">{p.name}</span>
                  <span class="row__meta">{p.status} · {p.kind}</span>
                  <span class="row__line">{p.line}</span>
                </div>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- THE KIT: before / after -->
  <section class="sec" data-margin="8" aria-labelledby="kit-title">
    <div class="grid">
      <div data-day>
        <div class="before" data-reveal="up">
          <p class="label">Before</p>
          <p class="l" style="margin-top:.5rem">Camera roll</p>
          <p style="margin-top:.5rem">Raw, uncut, waiting for a free evening.</p>
        </div>
      </div>
      <div data-dream>
        <p class="label">After · {kit.name}</p>
        <h2 id="kit-title" class="xl" style="margin-top:1rem" data-split="lines">Ready to post, in your own style</h2>
        <p class="lead" style="margin-top:1.5rem" data-reveal="up">{kit.promise}</p>
        <ul class="outcomes">
          {kit.outcomes.map((o, i) => (
            <li data-reveal="up" data-delay={String(i * 0.06)}><h3>{o.title}</h3><p>{o.text}</p></li>
          ))}
        </ul>
        <div class="actions" style="margin-top:2.5rem">
          <Btn href="/systems/edit-starter-kit/">See the Edit Starter Kit</Btn>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT IT ASKS OF YOU: a real sequence -->
  <section class="sec sec--tight" data-margin="8" aria-labelledby="steps-title">
    <div class="grid">
      <div data-day>
        <h2 id="steps-title" class="label">What plug and play asks of you</h2>
      </div>
      <div data-dream>
        <ol class="steps">
          {kit.steps.map((s, i) => (
            <li data-reveal="write" data-delay={String(i * 0.08)}>
              <h3>{s.title}</h3>
              <span class="time">{s.cost}</span>
            </li>
          ))}
        </ol>
        <p class="body" style="margin-top:1.5rem">That’s the whole routine. It runs in the Claude app on your computer, with nothing to install by hand. <a class="link" href="/systems/edit-starter-kit/">See how the kit works</a></p>
      </div>
    </div>
  </section>

  <!-- LIZZY: a letter in the margin -->
  <section class="sec" data-margin="10" aria-labelledby="note-title">
    <div class="grid">
      <div data-day>
        <p class="label">From the founder</p>
      </div>
      <div data-dream>
        <div class="letter">
          <h2 id="note-title" class="m" data-split="lines">Hi, I’m Lizzy. I’m a mom with a full-time job, building a business of my own.</h2>
          <p class="body" data-reveal="up">I recorded plenty of videos and posted very few, because editing took the hour I didn’t have. So I built the system I wished existed, one that already knows how I like my captions, my colours and my pace. House of Dreambuilders is where I share those systems with every mom building something in the little time she has.</p>
          <p class="hand sign" data-reveal="write">rooting for you, Lizzy</p>
          <p style="margin-top:1rem"><a class="link" href="/about/">Read the whole story</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- FINALE: the margin takes the page -->
  <section class="sec sec--airy finale" data-margin="full" aria-labelledby="end-title">
    <div class="grid">
      <div data-dream>
        <h2 id="end-title" class="mega" data-split="lines">Your dream deserves more than what’s left of you</h2>
        <p class="lead" data-reveal="up">Start with one recording this week. See it come back finished, in your style, before the weekend.</p>
        <div class="actions" data-reveal="up" data-delay="0.1">
          <Btn href={site.kitCheckout}>Get the Edit Starter Kit</Btn>
          <a class="link" href="/systems/">Browse all systems</a>
        </div>
      </div>
    </div>
  </section>
</Base>
