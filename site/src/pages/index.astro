---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import { site, day, program, kit } from '../data/site';
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: program.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base description={site.description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqLd)} />

  <!-- HERO: the day on the left, the dream in the margin -->
  <section class="hero" data-margin="4" aria-labelledby="hero-title">
    <div class="grid">
      <div data-day>
        <p class="label" data-reveal="fade" data-intro data-delay="0.5">A weekday, roughly</p>
        <ol class="schedule" aria-label="A typical weekday" style="margin-top:1rem">
          {day.map((d, i) => (
            <li class:list={{ 'is-margin': d.margin }} data-reveal="write" data-intro data-delay={String(0.35 + i * 0.09)}>
              <span class="time">{d.time}</span><span>{d.text}</span>
            </li>
          ))}
        </ol>
        <p class="schedule__note" data-reveal="write" data-intro data-delay="1.05">
          <svg viewBox="0 0 40 34" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M34 30C24 30 12 26 7 6M7 6 3 13M7 6l7 4" /></svg>
          <span class="hand">this hour is yours. be supermommy, not superbusy<span class="caret" data-caret aria-hidden="true"></span></span>
        </p>
      </div>
      <div data-dream>
        <h1 id="hero-title" data-split="lines" data-intro>Build your dream in the margins of a full life</h1>
        <p class="lead" data-split="lines" data-intro data-delay="0.25">Mentorship for moms who want more freedom, purpose and growth, and only have a few hours a week to build it. You do the part only you can do. AI does the long part.</p>
        <div class="actions" data-reveal="fade" data-intro data-delay="0.6">
          <Btn href="#apply">Apply to {program.name}</Btn>
          <a class="link" href={kit.href}>Or start with the free kit</a>
        </div>
      </div>
    </div>
  </section>

  <!-- THE DAY: why the dream waits -->
  <section class="sec" data-margin="4" aria-labelledby="day-title">
    <div class="grid">
      <div data-day>
        <h2 id="day-title" class="sr-only">Why the dream keeps waiting</h2>
        <p class="statement" data-split="lines">Family, a full-time job, and maybe ten minutes for yourself. <strong>By the time the house is quiet, there’s nothing left</strong> for the thing you actually want to build.</p>
      </div>
      <div data-dream>
        <p class="hand" data-reveal="write">you’re not lazy. your day is just full.</p>
        <p class="body" style="margin-top:1.25rem" data-reveal="up" data-delay="0.1">So the dream waits for a calmer season that never quite comes. It doesn’t have to. The margin is small, but it’s real, and with the right method it can carry a whole business.</p>
      </div>
    </div>
  </section>

  <!-- THE PROGRAM -->
  <section class="sec" data-margin="6" id="method" aria-labelledby="method-title">
    <div class="grid">
      <div data-day>
        <p class="label">{program.kind}</p>
        <p class="hand" style="margin-top:1.25rem" data-reveal="write">built for the hours you actually have</p>
      </div>
      <div data-dream>
        <h2 id="method-title" class="xl" data-split="lines">{program.name}</h2>
        <p class="lead" style="margin-top:1.5rem;color:var(--ink)" data-reveal="up">{program.promise}</p>
        <p class="body" style="margin-top:1.25rem" data-reveal="up" data-delay="0.08">Most business advice assumes you have whole days. You have evenings, lunch breaks and the ten minutes after drop-off. {program.name} is mentorship built for that reality: a clear plan for your hours, one offer worth building, and AI systems that take the repeating work off your plate.</p>
      </div>
    </div>
  </section>

  <!-- PHASES: a real sequence -->
  <section class="sec sec--tight" data-margin="8" aria-labelledby="phases-title">
    <div class="grid">
      <div data-day>
        <h2 id="phases-title" class="label">What we build together</h2>
      </div>
      <div data-dream>
        <ol class="steps">
          {program.phases.map((s, i) => (
            <li data-reveal="write" data-delay={String(i * 0.08)}>
              <h3>{s.title}</h3>
              <span class="time">{s.tag}</span>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- INCLUDED + FIT -->
  <section class="sec" data-margin="8" aria-labelledby="inc-title">
    <div class="grid">
      <div data-day>
        <p class="label">Inside the program</p>
      </div>
      <div data-dream>
        <h2 id="inc-title" class="l" data-split="lines">Support that fits around your family, not on top of it</h2>
        <ul class="ticks" style="margin-top:2.5rem">
          {program.included.map((x, i) => <li data-reveal="up" data-delay={String((i % 2) * 0.06)}><h3>{x.title}</h3><p>{x.text}</p></li>)}
        </ul>
        <div class="fit">
          <div data-reveal="up">
            <h3>This is for you if</h3>
            <ul>{program.forYou.map((t) => <li>{t}</li>)}</ul>
          </div>
          <div data-reveal="up" data-delay="0.06">
            <h3>It’s not for you if</h3>
            <ul class="fit__no">{program.notForYou.map((t) => <li>{t}</li>)}</ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LIZZY -->
  <section class="sec" data-margin="10" aria-labelledby="note-title">
    <div class="grid">
      <div data-day>
        <p class="label">Your mentor</p>
      </div>
      <div data-dream>
        <div class="letter">
          <h2 id="note-title" class="m" data-split="lines">Hi, I’m Lizzy. I’m a mom with a full-time job, building a business of my own.</h2>
          <p class="body" data-reveal="up">I know the evening slump, the half-edited videos and the plans that wait for a calmer month. So I built a way of working that fits in the margins, with systems that do the long part. {program.name} is how I teach it, one mom at a time.</p>
          <p class="hand sign" data-reveal="write">rooting for you, Lizzy</p>
          <p style="margin-top:1rem"><a class="link" href="/about/">Read the whole story</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ + free start -->
  <section class="sec" data-margin="10" aria-labelledby="faq-title">
    <div class="grid">
      <div data-day>
        <p class="label">Questions</p>
      </div>
      <div data-dream>
        <h2 id="faq-title" class="l" data-split="lines">Before you apply</h2>
        <div class="faq">
          {program.faq.map((f, i) => (
            <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>
          ))}
        </div>
        <a class="start" href={kit.href} data-reveal="up">
          <span class="label">Not ready yet?</span>
          <span class="start__name">Start with the free {kit.name}<span class="row__open" aria-hidden="true">open</span></span>
          <span class="start__line">Talk to your camera, get finished reels back in your style. A first taste of what AI can take off your plate.</span>
        </a>
      </div>
    </div>
  </section>

  <!-- FINALE: the margin takes the page -->
  <section class="sec sec--airy finale" data-margin="full" id="apply" aria-labelledby="end-title">
    <div class="grid">
      <div data-dream>
        <h2 id="end-title" class="mega" data-split="lines">Your dream deserves more than what’s left of you</h2>
        <p class="lead" data-reveal="up">Places in {program.name} are limited, so it starts with a short application. Tell me where you are and where you want to be. I read every one.</p>
        <div class="actions" data-reveal="up" data-delay="0.1">
          <Btn href={program.applyUrl}>Apply to {program.name}</Btn>
          <a class="link" href={kit.href}>Get the free kit first</a>
        </div>
      </div>
    </div>
  </section>
</Base>
